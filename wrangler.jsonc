{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gocreative",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // SPA fallback would answer /api/* with index.html, so the Worker claims it first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gocreative",
      // Placeholder until the remote database is created (ROADMAP 1.8); local D1 ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "gocreative-files" }],
  "observability": { "enabled": true }
}
