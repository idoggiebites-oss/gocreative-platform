{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gocreative",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // SPA fallback would answer /api/* with index.html, so the Worker claims it first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gocreative",
      "database_id": "7a1c2b9b-61ec-4c76-9e60-8e430f423257",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "gocreative-files" }],
  // Version preview hostnames would sit outside the Access app on the workers.dev host.
  "preview_urls": false,
  // Daily, in the shop's small hours: clears abandoned public upload sessions (worker/cron.ts).
  "triggers": { "crons": ["0 9 * * *"] },
  "observability": { "enabled": true }
}
